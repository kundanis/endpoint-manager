# Copy to `.env` (next to docker-compose.yml) and fill in. docker compose reads it automatically.

# --- Secrets (REQUIRED) --------------------------------------------------------------------
# SQL Server 'sa' password for the bundled database container. Must meet SQL complexity rules
# (>=8 chars, upper+lower+digit+symbol).
SA_PASSWORD=Ch4ngeMe_Str0ng!

# Restricted SQL login the server runs as - read/write on its own database only. sa is used
# only to create the database, apply migrations and create this login. Name: letters, digits
# and _ (default endpoint_app). Password: letters, digits and ! _ . - only, 12+ characters,
# upper+lower+digit (SQL complexity rules), not containing the login name.
APP_DB_USER=endpoint_app
APP_DB_PASSWORD=Ch4ngeMe_Login1

# Session signing key, 32+ characters. Generate: openssl rand -base64 48
# The server refuses to start with this example value.
JWT_SECRET=change-me-to-a-long-random-string

# Column encryption key - exactly 32 bytes, base64. Generate: openssl rand -base64 32
# BACK THIS UP: losing it makes encrypted fields permanently unrecoverable.
FIELD_ENCRYPTION_KEY=change-me-32-bytes-base64==

# First administrator (created on first start). Change the password: the example value (or
# anything under 12 characters) is refused.
ADMIN_EMAIL=admin@endpointone.local
ADMIN_PASSWORD=Ch4ngeMe_Admin!

# --- Optional ------------------------------------------------------------------------------
DB_NAME=EndpointManagerDb
# Turn licensing enforcement on once you've activated a license (default off).
LICENSE_ENFORCEMENT_ENABLED=false
# Public IPs/CIDRs allowed to open the admin console from the internet (comma-separated), e.g.
# your office's public IP. Private networks are always allowed; everyone else gets a 404.
ADMIN_ALLOWED_NETWORKS=
# Optional extra: advanced application control (Windows AppLocker) - DLL, PowerShell and batch
# blocking that also covers an open Command Prompt and scheduled tasks, plus Allow exceptions.
ADVANCED_APP_CONTROL=false
# Product edition: "full" (Endpoint IQ) or "threat-protection" (the separate Endpoint IQ Threat
# Protection edition: Endpoints, Threat Protection, Licensing and Administrators only).
PRODUCT_EDITION=full
# Threat Protection (Microsoft Defender management) on a full install with licence enforcement off.
# With enforcement on, the licence decides (module THREAT_PROTECTION).
THREAT_PROTECTION=false
