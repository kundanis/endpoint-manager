# Copy to `.env` (next to docker-compose.yml) and fill in. docker compose reads it automatically.

# --- Secrets (REQUIRED) --------------------------------------------------------------------
# SQL Server 'sa' password for the bundled database container. Must meet SQL complexity rules
# (>=8 chars, upper+lower+digit+symbol).
SA_PASSWORD=Ch4ngeMe_Str0ng!

# Session signing key. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Column encryption key - exactly 32 bytes, base64. Generate: openssl rand -base64 32
# BACK THIS UP: losing it makes encrypted fields permanently unrecoverable.
FIELD_ENCRYPTION_KEY=change-me-32-bytes-base64==

# First administrator (created on first start).
ADMIN_EMAIL=admin@endpointpro.local
ADMIN_PASSWORD=Ch4ngeMe_Admin!

# --- Optional ------------------------------------------------------------------------------
DB_NAME=EndpointManagerDb
# Turn licensing enforcement on once you've activated a license (default off).
LICENSE_ENFORCEMENT_ENABLED=false
