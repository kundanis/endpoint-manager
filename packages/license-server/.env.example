PORT=4200
JWT_SECRET=dev-only-change-me-to-a-long-random-string
LICENSE_ADMIN_EMAIL=vendor@endpointmanager.local
LICENSE_ADMIN_PASSWORD=changeme

# SQL Server — use a dedicated least-privilege login, not sa, and its OWN database
# (never share EndpointManagerDb — this is a genuinely separate system). Use the
# machine's actual hostname, not "localhost" — see endpoint-manager's own
# docs/tls-setup.md for why trustServerCertificate can be set to false only then.
DATABASE_URL="sqlserver://<machine-hostname>:1433;database=LicenseServerDb;user=ls_app_login;password=<pwd>;encrypt=true;trustServerCertificate=false"
SHADOW_DATABASE_URL="sqlserver://<machine-hostname>:1433;database=LicenseServerDb_shadow;user=ls_app_login;password=<pwd>;encrypt=true;trustServerCertificate=false"

# Optional — HTTPS, same PFX pattern as endpoint-manager's own packages/server.
TLS_PFX_PATH=
TLS_PFX_PASSPHRASE=
