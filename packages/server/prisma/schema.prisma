datasource db {
  provider          = "sqlserver"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id               String    @id @default(uuid())
  email            String    @unique @db.NVarChar(255)
  passwordHash     String    @db.NVarChar(100)
  // SUPER_ADMIN | ADMIN - a super admin implicitly has every module (moduleGrants is
  // irrelevant for them) and can manage other admin accounts; a plain ADMIN's access is
  // exactly the set of AdminModuleGrant rows below, further narrowed by whatever the
  // deployment's own license includes (see requireModule.ts vs requireModuleAccess.ts -
  // two independent gates, both must pass).
  role             String    @default("ADMIN") @db.NVarChar(20)
  createdByAdminId String?   @db.NVarChar(64)
  createdAt        DateTime  @default(now())
  lastLoginAt      DateTime?
  assetNotes       AssetNote[]
  moduleGrants     AdminModuleGrant[]
}

model AdminModuleGrant {
  id          String    @id @default(uuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  // One of the 6 product module keys (ENDPOINT_MANAGER, NETWORK_MANAGER, ...) - mirrors
  // the License Server's module keys by convention, not by import (same "no runtime
  // import across the licensing wire boundary" rule already used for every MODULE_LABELS
  // map in this codebase).
  moduleKey   String    @db.NVarChar(30)
  createdAt   DateTime  @default(now())

  @@unique([adminUserId, moduleKey])
}

model EnrollmentToken {
  id            String      @id @default(uuid())
  tokenHash     String      @unique @db.NVarChar(128)
  label         String
  usesRemaining Int         @default(1)
  expiresAt     DateTime
  revoked       Boolean     @default(false)
  createdAt     DateTime    @default(now())
  // Optional - when set, an agent that enrolls with this token is automatically added as a
  // member of this group (see enrollAgent() in enrollment.service.ts). SetNull rather than
  // Cascade: deleting a group later shouldn't retroactively invalidate an already-issued,
  // still-valid token, it just stops implying a group going forward.
  groupId       String?
  group         AssetGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  remoteInstallJobs RemoteInstallJob[]
}

// Console-triggered "install the agent on this endpoint for me" (Enrollment Tokens page) -
// the server reaches out to a not-yet-enrolled Windows machine over WinRM/PowerShell
// Remoting and runs the installer there, instead of an admin manually copying the exe and
// double-clicking it. See remoteInstall.service.ts. Deliberately does NOT store the admin
// credential used to reach each target anywhere (not on this row, not logged) - it only
// ever lives in process memory for the lifetime of the job.
model RemoteInstallJob {
  id               String              @id @default(uuid())
  tokenId          String?
  token            EnrollmentToken?    @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  serverUrl        String
  createdByAdminId String
  createdAt        DateTime            @default(now())
  tasks            RemoteInstallTask[]
}

model RemoteInstallTask {
  id           String           @id @default(uuid())
  jobId        String
  job          RemoteInstallJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  // Hostname or IP the admin typed in - whatever WinRM/Invoke-Command was pointed at.
  target       String           @db.NVarChar(255)
  status       String           @default("PENDING") @db.NVarChar(20) // PENDING | RUNNING | SUCCESS | FAILED
  output       String?          @db.NVarChar(Max)
  errorMessage String?          @db.NVarChar(Max)
  startedAt    DateTime?
  completedAt  DateTime?
}

model Agent {
  id              String              @id @default(uuid())
  hostname        String
  apiKeyHash      String              @unique @db.NVarChar(128)
  osPlatform      String
  osVersion       String
  osArch          String
  agentVersion    String
  ipAddress       String?
  macAddress      String?
  tags            String              @default("[]")
  lifecycleStatus String              @default("ACTIVE") @db.NVarChar(20)
  serialNumber       String?          @db.NVarChar(100)
  vendor             String?          @db.NVarChar(100)
  purchaseDate       DateTime?
  warrantyExpiryDate DateTime?
  deviceTypeOverride String?          @db.NVarChar(20)
  quarantined     Boolean             @default(false)
  edrEnabled      Boolean             @default(true)
  remoteAccessEnabled  Boolean        @default(false)
  remoteAccessEnabledAt DateTime?
  remoteAccessAllowedIp String?       @db.NVarChar(45)
  paused          Boolean             @default(false)
  pausedAt        DateTime?
  // Snapshot of enforcement that was actively released when this agent was paused (see
  // pause.service.ts), so resume can restore exactly what was in effect before - rather
  // than e.g. leaving a previously-quarantined machine unquarantined forever just because
  // it went through a pause/resume cycle.
  pausedFromQuarantined            Boolean @default(false)
  pausedFromRemoteAccessEnabled    Boolean @default(false)
  pausedFromRemoteAccessAllowedIp  String? @db.NVarChar(45)
  location        String?             @db.NVarChar(200)
  ipGeoCity       String?             @db.NVarChar(100)
  ipGeoRegion     String?             @db.NVarChar(100)
  ipGeoCountry    String?             @db.NVarChar(100)
  ipGeoLat        Float?
  ipGeoLon        Float?
  ipGeoLookupIp   String?             @db.NVarChar(64)
  ipGeoUpdatedAt  DateTime?
  lastCheckinAt   DateTime?
  createdAt       DateTime            @default(now())
  inventory       InventorySnapshot?
  commandTasks    CommandTask[]
  deployTasks     DeploymentTask[]
  agentUpdateTasks      AgentUpdateTask[]
  patchFindings         PatchFinding[]
  patchTasks            PatchTask[]
  vulnerabilityFindings VulnerabilityFinding[]
  groupMemberships      AgentGroupMembership[]
  customFieldValues     AgentCustomFieldValue[]
  notes                 AssetNote[]
  discoveredHostMatches DiscoveredHost[]
  securityBenchmarkFindings    SecurityBenchmarkFinding[]
  securityBenchmarkAssignments SecurityBenchmarkAssignment[]
  zeroTrustFindings    ZeroTrustFinding[]
  zeroTrustAssignments ZeroTrustPolicyAssignment[]
  zeroTrustCheckOverrides ZeroTrustCheckOverride[]
  dataDiscoveryFindings    DataDiscoveryFinding[]
  dataDiscoveryAssignments DataDiscoveryPolicyAssignment[]
  dataDiscoveryScanStates  DataDiscoveryScanState[]
  dlpEvents      DlpEvent[]
  dlpAssignments DlpPolicyAssignment[]
  dataMovementEvents      DataMovementEvent[]
  dataMovementAssignments DataMovementPolicyAssignment[]
  appControlEvents      AppControlEvent[]
  appControlAssignments AppControlPolicyAssignment[]
  webBlockAssignments   WebBlockPolicyAssignment[]
  piiBlockAssignments   PiiBlockPolicyAssignment[]
  commandBlockEvents      CommandBlockEvent[]
  commandBlockAssignments CommandBlockPolicyAssignment[]
  ipBlockAssignments IpBlockPolicyAssignment[]
  usbControlEvents      UsbControlEvent[]
  usbControlAssignments UsbControlPolicyAssignment[]
  policyAccessExceptions PolicyAccessException[]
  userSessions UserSession[]
  userProductivityDailyLogs UserProductivityDailyLog[]
  edrEvents EdrEvent[]
  edrPersistenceBaseline EdrPersistenceBaseline[]
}

model InventorySnapshot {
  id                String   @id @default(uuid())
  agentId           String   @unique
  agent             Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  cpuModel          String?
  cpuCores          Int?
  cpuPhysicalCores  Int?
  cpuSpeedGhz       Float?
  totalMemBytes     BigInt?
  memLayout         String   @default("[]") @db.NVarChar(Max)
  osInfo            String   @db.NVarChar(Max)
  osBuild           String?  @db.NVarChar(50)
  pcSystemType      Int?
  osLicenseStatus     String? @db.NVarChar(30)
  osLicenseChannel    String? @db.NVarChar(50)
  osPartialProductKey String? @db.NVarChar(20)
  lastLoggedOnUser  String?  @db.NVarChar(300)
  diskInfo          String   @db.NVarChar(Max)
  diskVolumes       String   @default("[]") @db.NVarChar(Max)
  installedSoftware String   @db.NVarChar(Max)
  batteryPresent               Boolean  @default(false)
  batteryDesignCapacityMwh     Int?
  batteryFullChargeCapacityMwh Int?
  batteryChargePercent         Int?
  batteryCycleCount            Int?
  batteryCharging              Boolean?
  batteryAcConnected           Boolean?
  collectedAt       DateTime @default(now())
}

model CommandTemplate {
  id               String   @id @default(uuid())
  name             String   @db.NVarChar(150)
  description      String?  @db.NVarChar(500)
  shell            String   @db.NVarChar(20)
  script           String   @db.NVarChar(Max)
  createdByAdminId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model CommandJob {
  id               String        @id @default(uuid())
  shell            String
  script           String        @db.NVarChar(Max)
  timeoutSec       Int           @default(120)
  createdByAdminId String
  targetGroupIds   String        @default("[]") @db.NVarChar(1000)
  // Lets checkin.service.ts still deliver this job's tasks to a PAUSED agent - reserved
  // for security-lifecycle actions (quarantine apply/release, remote access enable/disable,
  // remote uninstall) that must reach the endpoint regardless of pause, since pause has no
  // other way to actually be enforced/reversed on it. Never set true for routine
  // admin-dispatched commands/deployments/patches - those are exactly what pause holds back.
  bypassesPause    Boolean       @default(false)
  createdAt        DateTime      @default(now())
  tasks            CommandTask[]
}

model CommandTask {
  id           String     @id @default(uuid())
  jobId        String
  job          CommandJob @relation(fields: [jobId], references: [id])
  agentId      String
  agent        Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  status       String     @default("PENDING")
  exitCode     Int?
  stdout       String?    @db.NVarChar(Max)
  stderr       String?    @db.NVarChar(Max)
  dispatchedAt DateTime?
  completedAt  DateTime?

  // Every agent checkin looks up its own PENDING tasks (checkin.service.ts) - without this
  // that is a full table scan of all command history, per agent, every poll.
  @@index([agentId, status])
}

model Package {
  id                String          @id @default(uuid())
  name              String
  version           String
  filename          String
  storagePath       String
  fileSizeBytes     Int
  sha256            String
  installerType     String
  silentArgs        String
  uploadedByAdminId String
  createdAt         DateTime        @default(now())
  deployJobs        DeploymentJob[]
}

model DeploymentJob {
  id               String           @id @default(uuid())
  packageId        String
  package          Package          @relation(fields: [packageId], references: [id], onDelete: Cascade)
  createdByAdminId String
  targetGroupIds   String           @default("[]") @db.NVarChar(1000)
  createdAt        DateTime         @default(now())
  tasks            DeploymentTask[]
}

model DeploymentTask {
  id           String        @id @default(uuid())
  jobId        String
  job          DeploymentJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  agentId      String
  agent        Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  status       String        @default("PENDING")
  exitCode     Int?
  message      String?       @db.NVarChar(Max)
  dispatchedAt DateTime?
  completedAt  DateTime?

  // Looked up per agent on every checkin - see CommandTask's index note.
  @@index([agentId, status])
}

// Admin-initiated push of a new agent build to specific endpoints/groups - mirrors
// DeploymentJob/DeploymentTask exactly, except there's no Package row to point at: the
// payload is always whatever is currently staged at config.agentInstallerZipPath (one
// version live on this server at a time, matching how AGENT_INSTALLER_DIR already only
// ever holds one EndpointProAgentSetup.exe). targetVersion is stamped at dispatch time so
// a job's own record stays meaningful even after a later build replaces the staged files.
model AgentUpdateJob {
  id               String            @id @default(uuid())
  // "win32" or "linux" (matches Agent.osPlatform verbatim) - a job is always homogeneous:
  // createAgentUpdateJob groups the admin's selected agents by osPlatform and creates one
  // job per platform actually present in the selection, each carrying that platform's own
  // build. A mixed-OS selection therefore silently fans out into multiple jobs from one
  // admin click rather than requiring the admin to think about OS at all.
  platform         String            @db.NVarChar(20)
  targetVersion    String            @db.NVarChar(50)
  // Frozen at dispatch time from whatever agentBuild.service.ts reported then - not
  // re-read live at checkin time, so a job's own contract can't shift out from under an
  // in-flight rollout if a newer build happens to get staged on this server mid-rollout.
  sha256           String            @db.NVarChar(64)
  createdByAdminId String
  targetGroupIds   String            @default("[]") @db.NVarChar(1000)
  createdAt        DateTime          @default(now())
  tasks            AgentUpdateTask[]
}

model AgentUpdateTask {
  id           String         @id @default(uuid())
  jobId        String
  job          AgentUpdateJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  agentId      String
  agent        Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  // PENDING -> DISPATCHED (agent picked it up) -> DOWNLOADING -> APPLYING (detached helper
  // task registered, original process about to be torn down) -> SUCCESS/FAILED. Unlike a
  // software deployment, APPLYING can't resolve synchronously - the reporting process is
  // gone by the time the swap actually happens - so the detached helper itself reports the
  // final state, same self-report pattern already proven for remote uninstall.
  status       String    @default("PENDING")
  message      String?   @db.NVarChar(Max)
  dispatchedAt DateTime?
  completedAt  DateTime?

  // Looked up per agent on every checkin - see CommandTask's index note.
  @@index([agentId, status])
}

model PatchDefinition {
  id             String         @id @default(uuid())
  updateId       String         @unique @db.NVarChar(64)
  revisionNumber Int
  title          String         @db.NVarChar(500)
  severity       String?        @db.NVarChar(50)
  kbArticleIds   String         @default("[]") @db.NVarChar(1000)
  categories     String         @default("[]") @db.NVarChar(1000)
  sizeBytes      BigInt?
  firstSeenAt    DateTime       @default(now())
  lastSeenAt     DateTime       @default(now())
  findings       PatchFinding[]
}

model PatchFinding {
  id                String          @id @default(uuid())
  agentId           String
  agent             Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  patchDefinitionId String
  patchDefinition   PatchDefinition @relation(fields: [patchDefinitionId], references: [id], onDelete: Cascade)
  status            String          @default("MISSING")
  detectedAt        DateTime        @default(now())
  lastSeenAt        DateTime        @default(now())
  installedAt       DateTime?

  @@unique([agentId, patchDefinitionId])
}

model PatchJob {
  id               String      @id @default(uuid())
  updateIds        String      @db.NVarChar(Max)
  createdByAdminId String
  targetGroupIds   String      @default("[]") @db.NVarChar(1000)
  // Null = dispatch immediately (existing behavior, tasks created as PENDING). A future
  // timestamp creates tasks as SCHEDULED instead - see promoteScheduledPatchTasks(), which
  // flips them to PENDING once this time arrives, at which point the existing
  // checkin.service.ts PENDING-task query picks them up completely unchanged.
  scheduledAt      DateTime?
  createdAt        DateTime    @default(now())
  tasks            PatchTask[]
}

// A standing "Automatic Mode" policy - see createAutoPatchPolicyRequestSchema. Evaluated by
// a periodic sweep (runAutoPatchPolicies) rather than triggered per-scan, matching this
// codebase's existing preference for polling over event-driven triggers (e.g. license
// revalidation in index.ts).
model AutoPatchPolicy {
  id               String    @id @default(uuid())
  enabled          Boolean   @default(true)
  minSeverity      String    @db.NVarChar(20)
  targetGroupIds   String    @default("[]") @db.NVarChar(1000)
  createdByAdminId String
  createdAt        DateTime  @default(now())
  lastRunAt        DateTime?
}

model PatchTask {
  id             String    @id @default(uuid())
  jobId          String
  job            PatchJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  agentId        String
  agent          Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  status         String    @default("PENDING")
  rebootRequired Boolean   @default(false)
  results        String?   @db.NVarChar(Max)
  message        String?   @db.NVarChar(Max)
  dispatchedAt   DateTime?
  completedAt    DateTime?

  // Looked up per agent on every checkin - see CommandTask's index note.
  @@index([agentId, status])
}

model VulnerabilityDefinition {
  id                 String                  @id @default(uuid())
  cveId              String                  @unique @db.NVarChar(32)
  description        String                  @db.NVarChar(Max)
  cvssVersion        String?                 @db.NVarChar(10)
  cvssBaseScore      Float?
  cvssSeverity       String?                 @db.NVarChar(20)
  cvssVector         String?                 @db.NVarChar(512)
  publishedAt        DateTime
  lastModifiedAt     DateTime
  sourceLastSyncedAt DateTime                @default(now())
  cpeMatches         VulnerabilityCpeMatch[]
  findings           VulnerabilityFinding[]

  @@index([cvssSeverity])
  @@index([lastModifiedAt])
}

model VulnerabilityCpeMatch {
  id                        String                  @id @default(uuid())
  vulnerabilityDefinitionId String
  vulnerabilityDefinition   VulnerabilityDefinition @relation(fields: [vulnerabilityDefinitionId], references: [id], onDelete: Cascade)
  criteria                  String                  @db.NVarChar(512)
  part                      String                  @db.NVarChar(4)
  vendorNormalized          String                  @db.NVarChar(256)
  productNormalized         String                  @db.NVarChar(256)
  productCompact            String                  @db.NVarChar(256)
  versionExact              String?                 @db.NVarChar(128)
  versionStartIncluding     String?                 @db.NVarChar(128)
  versionStartExcluding     String?                 @db.NVarChar(128)
  versionEndIncluding       String?                 @db.NVarChar(128)
  versionEndExcluding       String?                 @db.NVarChar(128)
  vulnerable                Boolean                 @default(true)

  @@index([productCompact])
  @@index([productNormalized])
  // SQL Server doesn't index FK columns on its own. Without this, sync's per-CVE
  // deleteMany scans (and locks) the whole table and deadlocks with checkin-driven matching.
  @@index([vulnerabilityDefinitionId])
}

model VulnerabilityFinding {
  id                        String                  @id @default(uuid())
  agentId                   String
  agent                     Agent                   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  vulnerabilityDefinitionId String
  vulnerabilityDefinition   VulnerabilityDefinition @relation(fields: [vulnerabilityDefinitionId], references: [id], onDelete: Cascade)
  matchedSoftwareName       String                  @db.NVarChar(300)
  matchedSoftwareVersion    String?                 @db.NVarChar(100)
  matchedCpeCriteria        String                  @db.NVarChar(512)
  matchConfidence           String                  @db.NVarChar(20)
  status                    String                  @default("OPEN") @db.NVarChar(20)
  detectedAt                DateTime                @default(now())
  lastSeenAt                DateTime                @default(now())
  resolvedAt                DateTime?

  @@unique([agentId, vulnerabilityDefinitionId, matchedSoftwareName])
  @@index([agentId, status])
  // Per-agent / distinct-agent OPEN counts (dashboard summary + agents list, polled every few
  // seconds): WHERE status=OPEN GROUP BY agentId - seek on status, grouped by agentId.
  @@index([status, agentId])
  // Fleet vulnerability summary: WHERE status=OPEN GROUP BY definition, COUNT(DISTINCT agent)
  // - this covers it fully (no row lookups).
  @@index([status, vulnerabilityDefinitionId, agentId])
}

model VulnerabilitySyncRun {
  id                 String    @id @default(uuid())
  triggeredByAdminId String
  windowStartAt      DateTime
  windowEndAt        DateTime
  mode               String    @db.NVarChar(20)
  status             String    @default("RUNNING") @db.NVarChar(20)
  cveUpsertedCount   Int       @default(0)
  pagesFetched       Int       @default(0)
  errorMessage       String?   @db.NVarChar(Max)
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
}

model AssetGroup {
  id          String   @id @default(uuid())
  name        String   @unique @db.NVarChar(200)
  description String?  @db.NVarChar(1000)
  createdAt   DateTime @default(now())
  members     AgentGroupMembership[]
  securityBenchmarkAssignments SecurityBenchmarkAssignment[]
  zeroTrustAssignments ZeroTrustPolicyAssignment[]
  dataDiscoveryAssignments DataDiscoveryPolicyAssignment[]
  dlpAssignments DlpPolicyAssignment[]
  appControlAssignments AppControlPolicyAssignment[]
  webBlockAssignments   WebBlockPolicyAssignment[]
  piiBlockAssignments   PiiBlockPolicyAssignment[]
  commandBlockAssignments CommandBlockPolicyAssignment[]
  dataMovementAssignments DataMovementPolicyAssignment[]
  ipBlockAssignments IpBlockPolicyAssignment[]
  usbControlAssignments UsbControlPolicyAssignment[]
  enrollmentTokens   EnrollmentToken[]
}

model AgentGroupMembership {
  id      String     @id @default(uuid())
  agentId String
  agent   Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  groupId String
  group   AssetGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  addedAt DateTime   @default(now())

  @@unique([agentId, groupId])
  @@index([groupId])
}

model CustomFieldDefinition {
  id        String   @id @default(uuid())
  name      String   @unique @db.NVarChar(200)
  fieldType String   @db.NVarChar(20)
  options   String   @default("[]") @db.NVarChar(1000)
  createdAt DateTime @default(now())
  values    AgentCustomFieldValue[]
}

model AgentCustomFieldValue {
  id                String                @id @default(uuid())
  agentId           String
  agent             Agent                 @relation(fields: [agentId], references: [id], onDelete: Cascade)
  fieldDefinitionId String
  fieldDefinition   CustomFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)
  value             String                @db.NVarChar(1000)
  updatedAt         DateTime              @default(now())

  @@unique([agentId, fieldDefinitionId])
}

model AssetNote {
  id               String    @id @default(uuid())
  agentId          String
  agent            Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdByAdminId String
  createdByAdmin   AdminUser @relation(fields: [createdByAdminId], references: [id])
  body             String    @db.NVarChar(Max)
  createdAt        DateTime  @default(now())
}

// No FK to Agent — seats-in-use is estimated at read time by name-matching softwareName
// against each agent's installed-software inventory (same heuristic as vulnerability
// matching), not a manual per-device assignment table. Keeps this self-correcting as
// inventory changes without requiring an admin to manually (re)assign seats.
model NetworkVlan {
  id               String           @id @default(uuid())
  name             String           @db.NVarChar(100)
  description      String?          @db.NVarChar(500)
  cidr             String           @db.NVarChar(50)
  // Plain column, not a live FK relation to Agent — a real relation here, combined with
  // this model's own NetworkScanRun/DiscoveredHost chain (both cascading), would give SQL
  // Server two paths from Agent into DiscoveredHost (this one, and the pre-existing direct
  // DiscoveredHost.matchedAgentId), which it rejects. Resolved to a hostname at read time
  // with an "(agent deleted)" fallback, and validated fresh on every scan trigger (see
  // triggerVlanScan in networkVlan.service.ts) rather than relying on the DB to auto-clear it.
  assignedAgentId  String?
  enabled          Boolean          @default(true)
  createdByAdminId String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  scanRuns         NetworkScanRun[]
}

model NetworkScanRun {
  id                 String           @id @default(uuid())
  cidr               String           @db.NVarChar(50)
  status             String           @default("RUNNING") @db.NVarChar(20)
  hostsScanned       Int              @default(0)
  hostsFound         Int              @default(0)
  errorMessage       String?          @db.NVarChar(Max)
  triggeredByAdminId String
  vlanId             String?
  vlan               NetworkVlan?     @relation(fields: [vlanId], references: [id], onDelete: SetNull)
  // Snapshotted at trigger time so a run stays groupable/labeled even after its VLAN is
  // deleted — the live join above covers the common case (VLAN still exists), this is the
  // fallback. See NetworkVlan deletion handling in networkVlan.service.ts.
  vlanNameSnapshot   String?          @db.NVarChar(100)
  // The agent that actually executed THIS run (null = server-side). Deliberately a plain
  // column, not a live FK relation to Agent — a real relation here would give SQL Server
  // two cascade paths into this table (direct, and via NetworkVlan.assignedAgentId), which
  // it rejects outright. Resolved to a hostname at read time with a "(agent deleted)"
  // fallback, same pattern as resolveGroupNames()'s "(deleted group)" elsewhere in this codebase.
  agentId            String?
  startedAt          DateTime         @default(now())
  completedAt        DateTime?
  hosts              DiscoveredHost[]
  task               NetworkScanTask?

  @@index([vlanId])
}

// 1:1 with a run, not fan-out — a VLAN has at most one assigned agent, so there's no
// fan-out case to support (unlike CommandJob/CommandTask). Purely dispatch-mechanics state:
// which agent should pick this up is derived via scanRun.agentId (no separate agentId/FK
// here — same multi-cascade-path reason as NetworkScanRun.agentId above).
model NetworkScanTask {
  id           String         @id @default(uuid())
  scanRunId    String         @unique
  scanRun      NetworkScanRun @relation(fields: [scanRunId], references: [id], onDelete: Cascade)
  status       String         @default("PENDING") @db.NVarChar(20)
  dispatchedAt DateTime?
  completedAt  DateTime?
}

model DiscoveredHost {
  id             String         @id @default(uuid())
  scanRunId      String
  scanRun        NetworkScanRun @relation(fields: [scanRunId], references: [id], onDelete: Cascade)
  ipAddress      String         @db.NVarChar(45)
  macAddress     String?        @db.NVarChar(20)
  hostname       String?        @db.NVarChar(255)
  openPorts      String         @default("[]") @db.NVarChar(500)
  responseTimeMs Int?
  matchedAgentId String?
  matchedAgent   Agent?         @relation(fields: [matchedAgentId], references: [id], onDelete: SetNull)
  discoveredAt   DateTime       @default(now())

  @@index([scanRunId])
}

model SoftwareLicense {
  id               String    @id @default(uuid())
  softwareName     String    @db.NVarChar(300)
  version          String?   @db.NVarChar(50)
  vendor           String?   @db.NVarChar(200)
  licenseKey       String?   @db.NVarChar(500)
  licenseType      String    @db.NVarChar(30)
  seatsPurchased   Int
  // Manual override for "seats in use" - null means keep using the automatic estimate
  // (name-matched against agent inventory, see countAgentsWithMatchingSoftware in
  // softwareLicense.service.ts). Set this when that heuristic doesn't fit.
  seatsInUseOverride Int?
  purchaseDate     DateTime?
  expiryDate       DateTime?
  cost             Float?
  // How often `cost` recurs - MONTHLY | QUARTERLY | HALF_YEARLY | YEARLY. Defaults to
  // YEARLY for both new records (see the zod schema) and the migration backfill of
  // existing rows, so a pre-existing cost value's displayed yearly total is unchanged
  // until an admin deliberately picks a different cycle.
  billingCycle     String    @default("YEARLY") @db.NVarChar(20)
  deploymentType   String?   @db.NVarChar(100)
  accessType       String?   @db.NVarChar(20)
  userDepartment   String?   @db.NVarChar(200)
  notes            String?   @db.NVarChar(2000)
  createdByAdminId String
  createdAt        DateTime  @default(now())
}

model SecurityBenchmark {
  id               String                         @id @default(uuid())
  name             String                         @db.NVarChar(200)
  description      String?                        @db.NVarChar(1000)
  source           String                         @db.NVarChar(20) // BUILT_IN | CUSTOM
  targetType       String                         @default("WINDOWS_10") @db.NVarChar(30) // WINDOWS_10 | WINDOWS_11 | WINDOWS_SERVER | SQL_SERVER
  createdByAdminId String?
  createdAt        DateTime                       @default(now())
  rules            SecurityBenchmarkRule[]
  assignments      SecurityBenchmarkAssignment[]
  findings         SecurityBenchmarkFinding[]
}

model SecurityBenchmarkRule {
  id                    String                     @id @default(uuid())
  benchmarkId           String
  benchmark             SecurityBenchmark          @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)
  ruleKey               String                     @db.NVarChar(50)
  title                 String                     @db.NVarChar(300)
  description           String?                    @db.NVarChar(2000)
  severity              String                     @db.NVarChar(20) // HIGH | MEDIUM | LOW
  checkPowerShell       String                     @db.NVarChar(Max)
  operator              String                     @db.NVarChar(20) // EQUALS|NOT_EQUALS|GTE|LTE|CONTAINS|REGEX_MATCH
  expectedValue         String                     @db.NVarChar(500)
  remediationPowerShell String?                    @db.NVarChar(Max)
  createdAt             DateTime                   @default(now())
  findings              SecurityBenchmarkFinding[]

  @@unique([benchmarkId, ruleKey])
}

// agentId or groupId is set, never both — same standing-assignment shape as
// AgentGroupMembership, resolved at scan-fetch time (not fanned out to per-agent
// rows like PatchTask/CommandTask, since this isn't a one-off job).
model SecurityBenchmarkAssignment {
  id          String            @id @default(uuid())
  benchmarkId String
  benchmark   SecurityBenchmark @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)
  agentId     String?
  agent       Agent?            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  groupId     String?
  group       AssetGroup?       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())

  @@index([agentId])
  @@index([groupId])
}

model SecurityBenchmarkFinding {
  id            String                @id @default(uuid())
  agentId       String
  agent         Agent                 @relation(fields: [agentId], references: [id], onDelete: Cascade)
  benchmarkId   String
  // NoAction — deleting a benchmark already cascades to its rules (below), which in
  // turn cascade-delete this finding; a second cascade path to the same row via
  // benchmarkId directly is rejected by SQL Server ("multiple cascade paths").
  benchmark     SecurityBenchmark     @relation(fields: [benchmarkId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ruleId        String
  rule          SecurityBenchmarkRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  actualValue   String?               @db.NVarChar(2000)
  status        String                @default("FAIL") @db.NVarChar(20) // PASS | FAIL | ERROR
  detectedAt    DateTime              @default(now())
  lastSeenAt    DateTime              @default(now())

  @@unique([agentId, ruleId])
  @@index([agentId, status])
}

model ZeroTrustPolicy {
  id               String                      @id @default(uuid())
  name             String                      @db.NVarChar(200)
  description      String?                     @db.NVarChar(1000)
  enabled          Boolean                     @default(true)
  createdByAdminId String?
  createdAt        DateTime                    @default(now())
  conditions       ZeroTrustCondition[]
  assignments      ZeroTrustPolicyAssignment[]
  findings         ZeroTrustFinding[]
}

model ZeroTrustCondition {
  id              String             @id @default(uuid())
  policyId        String
  policy          ZeroTrustPolicy    @relation(fields: [policyId], references: [id], onDelete: Cascade)
  conditionKey    String             @db.NVarChar(50)
  title           String             @db.NVarChar(300)
  description     String?            @db.NVarChar(2000)
  checkPowerShell String             @db.NVarChar(Max)
  operator        String             @db.NVarChar(20) // EQUALS|NOT_EQUALS|GTE|LTE|CONTAINS|REGEX_MATCH
  expectedValue   String             @db.NVarChar(500)
  enabled         Boolean            @default(true)
  createdAt       DateTime           @default(now())
  findings        ZeroTrustFinding[]

  @@unique([policyId, conditionKey])
}

// agentId or groupId is set, never both — same standing-assignment shape as
// SecurityBenchmarkAssignment.
model ZeroTrustPolicyAssignment {
  id        String          @id @default(uuid())
  policyId  String
  policy    ZeroTrustPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  agentId   String?
  agent     Agent?          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  groupId   String?
  group     AssetGroup?     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@index([agentId])
  @@index([groupId])
}

model ZeroTrustFinding {
  id          String             @id @default(uuid())
  agentId     String
  agent       Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  policyId    String
  // NoAction — deleting a policy already cascades to its conditions, which in turn
  // cascade-delete this finding; a second cascade path via policyId directly is
  // rejected by SQL Server ("multiple cascade paths"). Same fix as SecurityBenchmarkFinding.
  policy      ZeroTrustPolicy    @relation(fields: [policyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  conditionId String
  condition   ZeroTrustCondition @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  actualValue String?            @db.NVarChar(2000)
  status      String             @default("FAIL") @db.NVarChar(20) // PASS | FAIL | ERROR
  detectedAt  DateTime           @default(now())
  lastSeenAt  DateTime           @default(now())

  @@unique([agentId, conditionId])
  @@index([agentId, status])
  // Fleet-wide "all FAIL findings" scan (agents list) filters on status alone.
  @@index([status])
}

// Scoped to conditionKey (a stable string reused across whichever policy/condition row
// actually carries it - see ZeroTrustCondition.conditionKey), not a specific
// ZeroTrustCondition id - so one override still applies if a condition gets deleted and
// re-added, or exists identically in more than one policy. Row presence = override active;
// there is no "disabled" override row, just delete it (see zeroTrustOverride.service.ts).
// Deliberately has no effect anywhere except the compliance-verdict aggregations it's
// explicitly wired into (zeroTrustNonCompliantCount, compliancePercent, per-agent
// pass/fail/trusted) - the underlying ZeroTrustFinding.status a device actually earned is
// never rewritten, so raw per-condition findings views keep showing real posture.
model ZeroTrustCheckOverride {
  id               String   @id @default(uuid())
  agentId          String
  agent            Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conditionKey     String   @db.NVarChar(50)
  appliedByAdminId String
  appliedAt        DateTime @default(now())

  @@unique([agentId, conditionKey])
}

// Unlike SecurityBenchmark/ZeroTrust, there's no per-policy child table for the
// individual PII patterns being checked — the pattern catalog (Aadhaar/PAN/email/...)
// is a fixed, code-level list in @em/shared, resolved from `regulation` at scan time,
// not authored per policy. That means DataDiscoveryFinding has only one path down from
// DataDiscoveryPolicy (this direct relation), so normal Cascade is safe here — no
// "multiple cascade paths" issue like SecurityBenchmarkFinding/ZeroTrustFinding had.
model DataDiscoveryPolicy {
  id               String                          @id @default(uuid())
  name             String                          @db.NVarChar(200)
  description      String?                         @db.NVarChar(1000)
  regulation       String                          @db.NVarChar(10) // DPDP | GDPR | BOTH
  targetPaths      String                          @db.NVarChar(Max) // JSON string array; env vars expanded agent-side
  enabled          Boolean                         @default(true)
  createdByAdminId String?
  createdAt        DateTime                        @default(now())
  assignments      DataDiscoveryPolicyAssignment[]
  findings         DataDiscoveryFinding[]
  scanStates       DataDiscoveryScanState[]
}

// agentId or groupId is set, never both — same standing-assignment shape as
// SecurityBenchmarkAssignment/ZeroTrustPolicyAssignment.
model DataDiscoveryPolicyAssignment {
  id        String              @id @default(uuid())
  policyId  String
  policy    DataDiscoveryPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  agentId   String?
  agent     Agent?              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  groupId   String?
  group     AssetGroup?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime            @default(now())

  @@index([agentId])
  @@index([groupId])
}

// One row per (agent, policy, file currently matching) — a fresh full scan replaces
// the set each time (files renamed/edited/deleted so they no longer match are removed,
// not left stale). matchedPatternKeys/matchCounts are JSON; deliberately no column ever
// holds the actual matched substrings — only which pattern types matched and how many
// times, so the sensitive data being detected never lands in this database.
model DataDiscoveryFinding {
  id                 String              @id @default(uuid())
  agentId            String
  agent              Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  policyId           String
  policy             DataDiscoveryPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  filePath           String              @db.NVarChar(1000)
  fileSizeBytes      BigInt
  fileModifiedAt     DateTime
  matchedPatternKeys String              @default("[]") @db.NVarChar(500)
  matchCounts        String              @default("{}") @db.NVarChar(1000)
  // patternKey -> up to a few masked previews (e.g. "••••••••6789") — never the raw
  // matched value. Lets an admin confirm a real match / spot a false positive without
  // this database ever holding the actual sensitive data it's scanning for.
  maskedSamples      String              @default("{}") @db.NVarChar(2000)
  detectedAt         DateTime            @default(now())
  lastSeenAt         DateTime            @default(now())

  @@unique([agentId, policyId, filePath])
  @@index([agentId])
}

// Upserted on every scan report, regardless of whether any files matched — a clean
// scan (0 findings) is otherwise indistinguishable from "never scanned" in
// DataDiscoveryFinding alone, since that table only ever holds currently-matching
// files. Not an append-only history log, just the latest state per (agent, policy).
// scanRequested is also how "Scan now" is signaled to the agent: set true when an
// admin requests an immediate scan, delivered via the next checkin response (same
// mechanism as CommandTask/PatchTask dispatch), and cleared back to false the moment
// this agent+policy's scan result actually comes in — deliberately a plain boolean
// flag rather than comparing scanRequestedAt/lastScannedAt timestamps against each
// other, which Prisma can't do in a single query without raw SQL.
model DataDiscoveryScanState {
  id            String              @id @default(uuid())
  agentId       String
  agent         Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  policyId      String
  policy        DataDiscoveryPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  filesScanned  Int?
  lastScannedAt DateTime?
  scanRequested Boolean             @default(false)

  @@unique([agentId, policyId])
}

// DLP (Data Loss Prevention) — inline, real-time detection on file writes, unlike Data
// Discovery's scheduled at-rest scan. Phase 1 (this schema + admin/console/agent
// plumbing) has no enforcement teeth on its own; Phase 2 is a native kernel-driver
// sidecar (adapted from an existing, already-validated minifilter project) that the
// Node.js agent relays policy to and events from — the agent itself never inspects
// file content. Same PII pattern catalog/regulation taxonomy as Data Discovery (see
// DataDiscoveryPolicy) — DLP differs in when detection runs and what happens on a
// match, not in what counts as personal data.
// A DLP policy is a set of admin-authored rules (DlpRule), not a regulation scope —
// see DlpRule for the rule taxonomy (content keyword/regex/pattern, blocked path,
// trusted process, file extension filter).
model DlpPolicy {
  id                 String                @id @default(uuid())
  name               String                @db.NVarChar(200)
  description        String?               @db.NVarChar(1000)
  enforcementMode    String                @default("ALERT_ONLY") @db.NVarChar(20) // ALERT_ONLY | BLOCK
  removableMediaOnly Boolean               @default(true)
  enabled            Boolean               @default(true)
  createdByAdminId   String?
  createdAt          DateTime              @default(now())
  rules              DlpRule[]
  assignments        DlpPolicyAssignment[]
  events             DlpEvent[]
}

// One row per admin-authored rule. `value` means something different depending on
// ruleType: keyword text, regex source, a PII_PATTERN_KEYS key, a path substring, a
// process image name, or a file extension. See DLP_RULE_TYPES in
// packages/shared/src/schemas/dlp.schema.ts for the full taxonomy.
model DlpRule {
  id        String    @id @default(uuid())
  policyId  String
  policy    DlpPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  ruleType  String    @db.NVarChar(30)
  value     String    @db.NVarChar(500)
  label     String?   @db.NVarChar(200)
  createdAt DateTime  @default(now())
}

// agentId or groupId is set, never both — same standing-assignment shape as
// SecurityBenchmarkAssignment/ZeroTrustPolicyAssignment/DataDiscoveryPolicyAssignment.
model DlpPolicyAssignment {
  id        String    @id @default(uuid())
  policyId  String
  policy    DlpPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  agentId   String?
  agent     Agent?    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  groupId   String?
  group     AssetGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([agentId])
  @@index([groupId])
}

// One row per real-time occurrence (a rule matched, or a blocked-path/trusted-process
// gate fired) — not a current-state table like DataDiscoveryFinding, so nothing is
// ever deleted/replaced here, just appended. matchedRuleIds/maskedSamples follow the
// identical never-the-raw-value discipline as DataDiscoveryFinding — a BLOCKED_PATH
// trigger has no content sample, so maskedSamples simply has no entry for its rule id.
model DlpEvent {
  id                     String    @id @default(uuid())
  agentId                String
  agent                  Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  policyId               String
  policy                 DlpPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  filePath               String    @db.NVarChar(1000)
  processName            String?   @db.NVarChar(300)
  destinationIsRemovable Boolean   @default(false)
  action                 String    @db.NVarChar(20) // ALERTED | BLOCKED
  matchedRuleIds         String    @default("[]") @db.NVarChar(500)
  maskedSamples          String    @default("{}") @db.NVarChar(2000)
  occurredAt             DateTime  @default(now())

  @@index([agentId])
  @@index([policyId])
}

// Data Movement — lightweight, agent-side exfiltration-channel monitoring (no kernel
// driver, unlike DLP's Phase 2 plan). Each scan cycle looks for files whose mtime falls
// within the recent lookback window in three kinds of locations: attached removable
// (USB) drives, well-known cloud-sync client folders (OneDrive/Dropbox/Google Drive)
// plus admin-configured extra paths, and currently-mapped network drives. This is a
// heuristic ("recently modified in a monitored location"), not a real interception —
// it can miss a copy made and then immediately scanned-past, or double-report if a
// file is touched again near a scan boundary; the per-event unique key absorbs the
// latter.
model DataMovementPolicy {
  id                  String                         @id @default(uuid())
  name                String                         @db.NVarChar(200)
  description         String?                        @db.NVarChar(1000)
  monitorUsb          Boolean                        @default(true)
  monitorCloudSync    Boolean                        @default(true)
  monitorNetworkShare Boolean                        @default(true)
  // JSON string array; env vars (%USERPROFILE% etc.) expanded agent-side — same idiom
  // as DataDiscoveryPolicy.targetPaths. Supplements the built-in OneDrive/Dropbox/
  // Google Drive candidate paths, doesn't replace them.
  extraCloudSyncPaths String                         @default("[]") @db.NVarChar(Max)
  enabled             Boolean                        @default(true)
  createdByAdminId    String?
  createdAt           DateTime                       @default(now())
  assignments         DataMovementPolicyAssignment[]
  events              DataMovementEvent[]
}

// agentId or groupId is set, never both — same standing-assignment shape as every
// other policy module (SecurityBenchmark/ZeroTrust/DataDiscovery/Dlp/...Assignment).
model DataMovementPolicyAssignment {
  id        String             @id @default(uuid())
  policyId  String
  policy    DataMovementPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  agentId   String?
  agent     Agent?             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  groupId   String?
  group     AssetGroup?        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())

  @@index([agentId])
  @@index([groupId])
}

// One row per detected copy — append-only like DlpEvent, not a current-state table like
// DataDiscoveryFinding, since each detection is a distinct occurrence in time. The
// unique key includes fileModifiedAt specifically so the same physical copy detected
// again in an overlapping scan window (timer drift) upserts into the same row instead
// of creating a duplicate, while a genuinely new copy of the same path (different
// mtime) still creates a new event.
model DataMovementEvent {
  id             String             @id @default(uuid())
  agentId        String
  agent          Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  policyId       String
  policy         DataMovementPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  filePath       String             @db.NVarChar(1000)
  fileSizeBytes  BigInt
  fileModifiedAt DateTime
  channel        String             @db.NVarChar(20) // USB | CLOUD_SYNC | NETWORK_SHARE
  // Channel-specific identity, JSON so the shape can vary without extra columns —
  // USB: {driveLetter, volumeLabel, serialNumber}; CLOUD_SYNC: {provider}; NETWORK_SHARE: {uncPath}.
  channelDetail  String             @default("{}") @db.NVarChar(1000)
  detectedAt     DateTime           @default(now())

  @@unique([agentId, policyId, filePath, channel, fileModifiedAt])
  @@index([agentId])
  @@index([policyId])
}

// User Productivity — passive session/idle tracking, not policy-gated (every enrolled
// agent always reports this, like inventory/patch scanning). loginAt is part of the
// identity key because the same (agent, username) has many distinct sign-ins over time,
// and Windows recycles numeric session IDs across logins — the logon timestamp itself is
// the only stable identity for "this one sign-in". "Logout" is inferred, not exact: the
// agent's quser-based scan only reports currently-visible sessions, so a session that
// stops appearing between polls has isActive/logoutAt stamped from the LAST poll it was
// seen in, bounded by the scan interval's granularity, not the true logoff instant.
model UserSession {
  id                 String    @id @default(uuid())
  agentId            String
  agent              Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  username           String    @db.NVarChar(300)
  loginAt            DateTime
  lastSeenAt         DateTime
  logoutAt           DateTime?
  currentIdleSeconds Int       @default(0)
  activeSecondsTotal Int       @default(0)
  idleSecondsTotal   Int       @default(0)
  isActive           Boolean   @default(true)

  @@unique([agentId, username, loginAt])
  @@index([agentId])
}

// One row per (agent, user, calendar day) — a persisted daily rollup so historical
// records/reports survive independently of UserSession (which tracks live per-login-session
// state, not a day boundary). Updated incrementally on every scan rather than by a
// midnight rollover job, same "accumulate as you go" shape as UserSession itself. A
// session's elapsed window is attributed entirely to the calendar day of the scan that
// observed it — a midnight-spanning session can misattribute at most one scan interval's
// worth of time to the wrong day, the same bounded-by-scan-interval coarseness already
// accepted everywhere else in this module.
model UserProductivityDailyLog {
  id                 String    @id @default(uuid())
  agentId            String
  agent              Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  username           String    @db.NVarChar(300)
  logDate            DateTime
  firstLoginAt       DateTime
  // Last time this specific day's row was touched by a scan — lets a PAST day's row
  // show a sensible "last seen" fallback in place of a real logout when the session
  // simply carried over past midnight without ever truly signing out that day.
  lastSeenAt         DateTime  @default(now())
  lastLogoutAt       DateTime?
  activeSecondsTotal Int       @default(0)
  idleSecondsTotal   Int       @default(0)

  @@unique([agentId, username, logDate])
  @@index([agentId])
}

// EDR-lite — built-in (not admin-authored) detections, append-only like every other
// *Event table in this codebase. category discriminates PROCESS (a process-tree or
// command-line rule matched — ruleKey/severity/killed all apply) from PERSISTENCE (a
// new Run-key/service/scheduled-task entry — no ruleKey, always MEDIUM, never killed).
model EdrEvent {
  id         String   @id @default(uuid())
  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  category   String   @db.NVarChar(20)
  ruleKey    String?  @db.NVarChar(50)
  severity   String   @db.NVarChar(10)
  summary    String   @db.NVarChar(300)
  // Max, not a fixed cap — this is a JSON envelope around an already-bounded (2000 char)
  // commandLine/command field; the envelope's own overhead can push a near-cap value
  // past a same-sized column, so the wrapper needs headroom the wrapped field doesn't.
  detail     String   @db.NVarChar(Max)
  killed     Boolean  @default(false)
  detectedAt DateTime
  createdAt  DateTime @default(now())

  @@index([agentId])
}

// The server-held "known persistence items" baseline EdrEvent's PERSISTENCE category
// diffs against — an agent restart never re-floods "everything is new" because the
// agent always reports its full current snapshot, not a self-tracked delta (see
// edr.schema.ts). The machine's pre-existing startup items are seeded silently on an
// agent's first-ever scan; only entries appearing in a LATER scan are flagged.
model EdrPersistenceBaseline {
  id       String   @id @default(uuid())
  agentId  String
  agent    Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  location String   @db.NVarChar(300)
  name     String   @db.NVarChar(300)
  seenAt   DateTime @default(now())

  @@unique([agentId, location, name])
  @@index([agentId])
}

// EPM — Application & Extension Control (Software Restriction Policy-based).
model AppControlPolicy {
  id               String                       @id @default(uuid())
  name             String                       @db.NVarChar(200)
  description      String?                      @db.NVarChar(1000)
  enabled          Boolean                      @default(true)
  createdByAdminId String?
  createdAt        DateTime                     @default(now())
  rules            AppControlRule[]
  assignments      AppControlPolicyAssignment[]
  events           AppControlEvent[]
}

model AppControlRule {
  id        String           @id @default(uuid())
  policyId  String
  policy    AppControlPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  ruleType  String           @db.NVarChar(30)
  value     String           @db.NVarChar(500)
  label     String?          @db.NVarChar(200)
  createdAt DateTime         @default(now())
}

model AppControlPolicyAssignment {
  id        String           @id @default(uuid())
  policyId  String
  policy    AppControlPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  agentId   String?
  agent     Agent?           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  groupId   String?
  group     AssetGroup?      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@index([agentId])
  @@index([groupId])
}

// ruleId is a plain string (not a live FK) so deleting a rule never cascades away
// historical events — same discipline as DlpEvent.matchedRuleIds. policyId IS a real FK
// (SetNull) since deleting the whole policy is a coarser, more deliberate action where
// orphaned history is acceptable.
model AppControlEvent {
  id          String            @id @default(uuid())
  agentId     String
  agent       Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  policyId    String?
  policy      AppControlPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  ruleId      String?
  matchedPath String?           @db.NVarChar(1000)
  processName String?           @db.NVarChar(300)
  occurredAt  DateTime          @default(now())

  @@index([agentId])
}

// EPM — Web & Cloud Storage/Email Blocking (hosts-file + browser managed policy).
model WebBlockPolicy {
  id               String                     @id @default(uuid())
  name             String                     @db.NVarChar(200)
  description      String?                    @db.NVarChar(1000)
  enabled          Boolean                    @default(true)
  createdByAdminId String?
  createdAt        DateTime                   @default(now())
  rules            WebBlockRule[]
  assignments      WebBlockPolicyAssignment[]
}

model WebBlockRule {
  id        String         @id @default(uuid())
  policyId  String
  policy    WebBlockPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  ruleType  String         @db.NVarChar(30)
  value     String         @db.NVarChar(255)
  label     String?        @db.NVarChar(200)
  createdAt DateTime       @default(now())
}

// lastSyncedAt/lastSyncStatus/lastSyncError live directly on the assignment row rather than
// a separate event log — hosts-file/registry blocking has no convenient "a block just
// happened" signal, so this is a health-check style status, not an audit trail.
model WebBlockPolicyAssignment {
  id             String         @id @default(uuid())
  policyId       String
  policy         WebBlockPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  agentId        String?
  agent          Agent?         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  groupId        String?
  group          AssetGroup?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  lastSyncedAt   DateTime?
  lastSyncStatus String?        @db.NVarChar(20)
  lastSyncError  String?        @db.NVarChar(1000)

  @@index([agentId])
  @@index([groupId])
}

// EPM — PII Data Blocking. Same re-assert-declarative-state shape as Web Block (no event
// log, just a sync-health snapshot per assignment) — a rule's `value` is a PII_PATTERN_KEYS
// key (packages/shared/src/data/piiPatterns.ts), the same catalog Data Discovery and DLP's
// CONTENT_PATTERN rule type already use, so "credit card number" means the same thing
// everywhere in this product. Note: agent-side content inspection/enforcement for this
// module isn't wired up yet (same "policy layer ships ahead of the enforcement sidecar"
// situation as DLP's BLOCK mode) — policies can be authored and assigned now regardless.
model PiiBlockPolicy {
  id               String                     @id @default(uuid())
  name             String                     @db.NVarChar(200)
  description      String?                    @db.NVarChar(1000)
  enabled          Boolean                    @default(true)
  createdByAdminId String?
  createdAt        DateTime                   @default(now())
  rules            PiiBlockRule[]
  assignments      PiiBlockPolicyAssignment[]
}

model PiiBlockRule {
  id        String         @id @default(uuid())
  policyId  String
  policy    PiiBlockPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  ruleType  String         @db.NVarChar(30)
  value     String         @db.NVarChar(255)
  label     String?        @db.NVarChar(200)
  createdAt DateTime       @default(now())
}

model PiiBlockPolicyAssignment {
  id             String         @id @default(uuid())
  policyId       String
  policy         PiiBlockPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  agentId        String?
  agent          Agent?         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  groupId        String?
  group          AssetGroup?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  lastSyncedAt   DateTime?
  lastSyncStatus String?        @db.NVarChar(20)
  lastSyncError  String?        @db.NVarChar(1000)

  @@index([agentId])
  @@index([groupId])
}

// Email Attachment Blocking — scans attachments entirely client-side inside the Outlook
// add-in's own JS runtime (see packages/outlook-addin/) at send time; the raw attachment
// content NEVER reaches this server, only which PII categories matched (never the matched
// values themselves — same discipline as DlpEvent's maskedSamples). Unlike PiiBlockPolicy
// (endpoint agents/groups), this targets individual mailboxes by email address, since a
// mailbox has no Agent record of its own. The two public (unauthenticated) endpoints this
// feeds — policy lookup by email, and event reporting — are reachable from inside Outlook's
// sandboxed add-in runtime, which cannot hold this app's own admin session or agent API key.
model PiiEmailBlockPolicy {
  id               String                      @id @default(uuid())
  name             String                      @db.NVarChar(200)
  description      String?                     @db.NVarChar(1000)
  enabled          Boolean                     @default(true)
  createdByAdminId String?
  createdAt        DateTime                    @default(now())
  rules            PiiEmailBlockRule[]
  assignments      PiiEmailBlockAssignment[]
  events           PiiEmailBlockEvent[]
}

model PiiEmailBlockRule {
  id        String              @id @default(uuid())
  policyId  String
  policy    PiiEmailBlockPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  ruleType  String              @db.NVarChar(30)
  value     String              @db.NVarChar(255)
  label     String?             @db.NVarChar(200)
  createdAt DateTime            @default(now())
}

model PiiEmailBlockAssignment {
  id           String              @id @default(uuid())
  policyId     String
  policy       PiiEmailBlockPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  emailAddress String              @db.NVarChar(320)
  createdAt    DateTime            @default(now())

  @@index([policyId])
  @@index([emailAddress])
}

// Append-only audit trail (mirrors DlpEvent's shape) — matchedCategoryLabels is a JSON
// array of display labels only (e.g. ["Credit/debit card number"]), never the matched
// text itself, since the whole point of client-side scanning is that content never leaves
// the mail client.
model PiiEmailBlockEvent {
  id                     String              @id @default(uuid())
  policyId               String?
  policy                 PiiEmailBlockPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  senderEmail            String              @db.NVarChar(320)
  attachmentName         String              @db.NVarChar(500)
  action                 String              @db.NVarChar(20) // BLOCKED | ALLOWED_WARNED
  matchedCategoryLabels  String              @default("[]") @db.NVarChar(1000)
  occurredAt             DateTime            @default(now())

  @@index([senderEmail])
  @@index([policyId])
}

// EPM — IP Blocking (Windows Firewall block rules on assigned IP/CIDR addresses). Same
// re-assert-declarative-state shape as Web Block: no event log (asserting a firewall rule
// has no convenient "a connection was just blocked" signal without enabling and parsing
// firewall logs), just a sync-health snapshot per assignment.
model IpBlockPolicy {
  id               String                  @id @default(uuid())
  name             String                  @db.NVarChar(200)
  description      String?                 @db.NVarChar(1000)
  enabled          Boolean                 @default(true)
  createdByAdminId String?
  createdAt        DateTime                @default(now())
  rules            IpBlockRule[]
  assignments      IpBlockPolicyAssignment[]
}

model IpBlockRule {
  id        String        @id @default(uuid())
  policyId  String
  policy    IpBlockPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  ruleType  String        @db.NVarChar(30)
  value     String        @db.NVarChar(64)
  label     String?       @db.NVarChar(200)
  createdAt DateTime      @default(now())
}

model IpBlockPolicyAssignment {
  id             String        @id @default(uuid())
  policyId       String
  policy         IpBlockPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  agentId        String?
  agent          Agent?        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  groupId        String?
  group          AssetGroup?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  lastSyncedAt   DateTime?
  lastSyncStatus String?       @db.NVarChar(20)
  lastSyncError  String?       @db.NVarChar(1000)

  @@index([agentId])
  @@index([groupId])
}

// EPM — Custom Command Blocking (periodic process command-line scan-and-kill).
model CommandBlockPolicy {
  id               String                         @id @default(uuid())
  name             String                         @db.NVarChar(200)
  description      String?                        @db.NVarChar(1000)
  enabled          Boolean                        @default(true)
  // Defaults to BLOCK at the DB level specifically so this migration's backfill preserves
  // every pre-existing policy's actual current behavior (always kills on match, the only
  // behavior that ever existed before this column). The zod create schema separately
  // defaults NEW policies to ALERT_ONLY - see commandBlock.schema.ts's comment.
  enforcementMode  String                         @default("BLOCK") @db.NVarChar(20)
  createdByAdminId String?
  createdAt        DateTime                       @default(now())
  rules            CommandBlockRule[]
  assignments      CommandBlockPolicyAssignment[]
  events           CommandBlockEvent[]
}

model CommandBlockRule {
  id        String             @id @default(uuid())
  policyId  String
  policy    CommandBlockPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  ruleType  String             @db.NVarChar(30)
  value     String             @db.NVarChar(500)
  label     String?            @db.NVarChar(200)
  createdAt DateTime           @default(now())
}

model CommandBlockPolicyAssignment {
  id        String             @id @default(uuid())
  policyId  String
  policy    CommandBlockPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  agentId   String?
  agent     Agent?             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  groupId   String?
  group     AssetGroup?        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())

  @@index([agentId])
  @@index([groupId])
}

// ruleId required (not nullable, unlike AppControlEvent) — a command-block match is always
// directly attributable to the specific rule that fired, no ambiguous OS-log correlation
// involved. Plain string, not a live FK, same reasoning as AppControlEvent.ruleId.
model CommandBlockEvent {
  id                 String              @id @default(uuid())
  agentId            String
  agent              Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  policyId           String?
  policy             CommandBlockPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  ruleId             String
  matchedCommandLine String              @db.NVarChar(2000)
  processName        String?             @db.NVarChar(300)
  // Historical events were always real kills (no alert-only mode existed before this
  // column), hence the BLOCKED default for the backfill.
  action             String              @default("BLOCKED") @db.NVarChar(20)
  occurredAt         DateTime            @default(now())

  @@index([agentId])
}

// EPM — USB/removable-storage device control. Unlike App Control/Web Block (no reliable
// block-just-happened signal), a disabled device IS a well-defined, directly-attributable
// event — same reasoning as CommandBlockEvent, so this gets an event log too. Rule value is
// a USB drive's serial number (parsed agent-side from its PNPDeviceID); enforcement disables
// the specific PnP device instance rather than a GPO-level device-ID allow/deny list, since
// Windows' native DeviceInstall\Restrictions policy matches on hardware ID (vendor/product),
// not the per-unit serial number baked into the instance ID.
model UsbControlPolicy {
  id               String                     @id @default(uuid())
  name             String                     @db.NVarChar(200)
  description      String?                    @db.NVarChar(1000)
  enabled          Boolean                    @default(true)
  createdByAdminId String?
  createdAt        DateTime                   @default(now())
  rules            UsbControlRule[]
  assignments      UsbControlPolicyAssignment[]
  events           UsbControlEvent[]
}

model UsbControlRule {
  id        String           @id @default(uuid())
  policyId  String
  policy    UsbControlPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  ruleType  String           @db.NVarChar(30)
  value     String           @db.NVarChar(100)
  label     String?          @db.NVarChar(200)
  createdAt DateTime         @default(now())
}

model UsbControlPolicyAssignment {
  id             String           @id @default(uuid())
  policyId       String
  policy         UsbControlPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  agentId        String?
  agent          Agent?           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  groupId        String?
  group          AssetGroup?      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  lastSyncedAt   DateTime?
  lastSyncStatus String?          @db.NVarChar(20)
  lastSyncError  String?          @db.NVarChar(1000)

  @@index([agentId])
  @@index([groupId])
}

model UsbControlEvent {
  id             String            @id @default(uuid())
  agentId        String
  agent          Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  policyId       String?
  policy         UsbControlPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  serialNumber   String            @db.NVarChar(100)
  deviceDescription String?        @db.NVarChar(300)
  action         String            @db.NVarChar(20) // DISABLED
  occurredAt     DateTime          @default(now())

  @@index([agentId])
}

// Time-bound, admin-approved carve-out from an EPM/DLP policy's enforcement for one agent.
// Spans multiple unrelated policy tables (App Control, Web Block, Command Block, IP Block,
// USB Control, DLP), so policyId is a plain string, not a live FK — same reasoning already
// used elsewhere in this schema for a cross-table reference (see NetworkScanRun.agentId).
// Deliberately no stored EXPIRED status: "is this exception currently active" is always
// computed at read time as status=="APPROVED" && expiresAt > now(), the same
// computed-not-stored idiom already used for Zero Trust's "trusted" verdict and Security
// Configuration's compliance percentage, so nothing needs a background job to revert it.
model PolicyAccessException {
  id                 String    @id @default(uuid())
  policyType         String    @db.NVarChar(30) // APP_CONTROL | WEB_BLOCK | COMMAND_BLOCK | IP_BLOCK | USB_CONTROL | DLP
  policyId           String
  agentId            String
  agent              Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  reason             String    @db.NVarChar(1000)
  durationMinutes    Int
  status             String    @default("PENDING") @db.NVarChar(20) // PENDING | APPROVED | REJECTED
  requestedByAdminId String
  approvedByAdminId  String?
  resolvedAt         DateTime?
  resolutionNote     String?   @db.NVarChar(1000)
  expiresAt          DateTime?
  createdAt          DateTime  @default(now())

  @@index([agentId])
  @@index([policyType, policyId])
}

// Singleton — deployment-wide agent tamper-protection setting. uninstallPasswordHash is
// null (protection off) until an admin sets one — matches the "off by default until
// configured" convention already used for LICENSE_ENFORCEMENT_ENABLED. bcrypt-hashed, same
// as AdminUser.passwordHash, since it's checked the same way (compare, never re-displayed).
model AgentSecuritySettings {
  id                    String   @id @default("singleton")
  uninstallPasswordHash String?  @db.NVarChar(200)
  updatedAt             DateTime @updatedAt
}

// Singleton — which central License Server this deployment talks to. Deliberately a
// runtime, admin-configured DB setting, not a deploy-time env var: the entity admin
// enters this (Console -> Licensing -> Licence API) *after* their own first login, tests
// connectivity, and only then proceeds to activate a license key — see
// licenseServerConfig.service.ts.
model LicenseServerConfig {
  id                    String    @id @default("singleton")
  serverUrl             String    @db.NVarChar(500)
  lastConnectionCheckAt DateTime?
  lastConnectionOk      Boolean?
  updatedAt             DateTime  @updatedAt
}

// Singleton — the addresses agents use to reach this server, in the order they try them:
// localUrl (LAN IP:port), webUrl (the HTTPS domain URL), publicUrl (NAT'd public IP:port).
// Baked into each per-token setup exe and pushed to enrolled agents on every check-in, so an
// endpoint that moves between the office LAN and the internet keeps finding the server - see
// agentConnection.service.ts and the agents' serverEndpoints.ts. All optional: until an
// admin saves this, localUrl falls back to an auto-detected LAN address.
model AgentConnectionSettings {
  id        String   @id @default("singleton")
  localUrl  String?  @db.NVarChar(500)
  webUrl    String?  @db.NVarChar(500)
  publicUrl String?  @db.NVarChar(500)
  updatedAt DateTime @updatedAt
}

// Singleton — org-wide "hide this for everyone" toggle, at two granularities:
//   - hiddenModuleKeys: whole top-level modules (AdminModuleKey values, e.g.
//     "ENDPOINT_MANAGER") - hidden from the nav AND actually blocked server-side (see
//     requireModuleVisible in middleware/requireModule.ts), the same way every module
//     mount in app.ts is already gated by requireModule/requireModuleAccess. This is a
//     THIRD, most-authoritative gate, stacked on top of the other two (LicenseActivation.
//     modules = what the license includes; AdminModuleGrant = what a specific ADMIN was
//     granted) and overrides both - even a SUPER_ADMIN, who otherwise bypasses
//     AdminModuleGrant entirely.
//   - hiddenItemPaths: individual sub-items within a module (console route paths, e.g.
//     "/commands", "/dlp") - hidden from the nav and redirected away client-side
//     (RequireModule.tsx), but NOT separately blocked server-side, since most sub-items
//     don't have their own isolated API surface distinct from siblings (e.g. Endpoints/
//     Enrollment Tokens both fall under the same generic admin.routes.ts catch-all) - only
//     whole-module hiding gets the stronger, API-enforced guarantee.
// Dashboard/Licensing/Administrators are deliberately never hideable via either list (no
// way back in otherwise) - enforced in the console, not here.
model ModuleVisibilitySettings {
  id               String   @id @default("singleton")
  hiddenModuleKeys String   @default("[]") @db.NVarChar(1000)
  hiddenItemPaths  String   @default("[]") @db.NVarChar(2000)
  updatedAt        DateTime @updatedAt
}

// Singleton — this deployment has exactly one license, so the app always reads/writes
// the row with id "singleton" rather than looking one up by any other key. keyString and
// bindingToken are stored encrypted (not hashed) because, unlike the License Server side,
// this deployment must send both back verbatim on every /revalidate and /unlock-request
// call — see utils/fieldEncryption.ts (the same AES-256-GCM layer already used for
// SoftwareLicense.licenseKey and CommandJob/CommandTemplate.script).
model LicenseActivation {
  id                    String    @id @default("singleton")
  deploymentId          String    @unique @db.NVarChar(100)
  entityName            String    @db.NVarChar(200)
  maxAgents             Int
  // Denormalized JSON array of LicenseModule keys (@license/shared's LICENSE_MODULES) -
  // which top-level console modules this activation unlocks. Defaults to every module
  // for rows that predate this column, same backward-compat reasoning as License
  // Server's LicenseKey.modules: an already-activated deployment must not suddenly lose
  // access to everything the moment this ships, before its next revalidate() confirms
  // the real value from the License Server.
  modules               String    @default("[\"ENDPOINT_MANAGER\",\"NETWORK_MANAGER\",\"SOFTWARE_MANAGER\",\"SECURITY_MANAGER\",\"DATA_MANAGER\",\"USER_MANAGER\"]") @db.NVarChar(1000)
  validityType          String    @db.NVarChar(20) // ONE_YEAR | TWO_YEAR | THREE_YEAR | PERPETUAL
  validUntil            DateTime?
  keyStringEncrypted    String    @db.NVarChar(500)
  bindingTokenEncrypted String    @db.NVarChar(500)
  status                String    @default("ACTIVATED") @db.NVarChar(20) // ACTIVATED | REVOKED
  activatedAt           DateTime
  lastRevalidatedAt     DateTime?
  lastRevalidationError String?   @db.NVarChar(1000)
  // Lifetime count of agents actually uninstalled/removed from this deployment (not
  // currently-active seats - see currentAgentCount, which is always a live COUNT(*)).
  // Incremented once per Agent row deletion, whether via the self-report uninstall path
  // or an admin's manual delete - both represent one seat being fully consumed and given
  // back over this license's history, independent of how many are active right now.
  totalAgentsUninstalled Int      @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}
