PORT=4000
JWT_SECRET=dev-only-change-me-to-a-long-random-string
ADMIN_EMAIL=admin@endpointmanager.local
ADMIN_PASSWORD=changeme
UPLOADS_DIR=./uploads
# Optional — where "Download agent installer" (Console → Enrollment tokens) reads
# EndpointProAgentSetup.exe from. Build it with `npm run package -w @em/agent` and place
# it in this folder.
AGENT_INSTALLER_DIR=./agent-installer

# Optional — HTTPS. Leave both unset to run over plain HTTP (fine if TLS is terminated by
# a reverse proxy in front of this server instead). See docs/tls-setup.md for how to
# generate certs/dev-server.pfx (self-signed, dev/test only) or supply a real cert.
TLS_PFX_PATH=
TLS_PFX_PASSPHRASE=

# Required — AES-256-GCM key for column-level encryption of specifically sensitive
# fields (SoftwareLicense.licenseKey, CommandJob/CommandTemplate.script, CommandTask.
# stdout/stderr). Generate with:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
# or any other source of 32 cryptographically random bytes, base64-encoded. Losing this
# key makes every value it ever encrypted permanently unrecoverable — back it up
# wherever the DB backup/TDE certificate already lives.
FIELD_ENCRYPTION_KEY=

# SQL Server — use a dedicated least-privilege login, not sa. See docs/ for provisioning.
# Use the machine's actual hostname, not "localhost" — SQL Server's auto-generated
# self-signed certificate is issued for the machine's own hostname, so trustServerCertificate
# can be set to false (real validation) only when the connection target matches that name.
# "localhost" will fail validation with "target principal name is incorrect".
DATABASE_URL="sqlserver://<machine-hostname>:1433;database=EndpointManagerDb;user=em_app_login;password=<pwd>;encrypt=true;trustServerCertificate=false"
SHADOW_DATABASE_URL="sqlserver://<machine-hostname>:1433;database=EndpointManagerDb_shadow;user=em_app_login;password=<pwd>;encrypt=true;trustServerCertificate=false"

# Optional — speeds up NVD sync from 5 req/30s to 50 req/30s. Free signup at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
NVD_REQUEST_DELAY_MS=700

# If this network has a TLS-inspecting proxy (self-signed cert in the chain — common on
# corporate networks), Node's native fetch() will fail NVD sync with "self-signed
# certificate in certificate chain". Fix: run the server with
#   NODE_OPTIONS=--use-system-ca npm run dev
# This makes Node trust the OS certificate store (which already trusts the proxy's CA)
# instead of disabling TLS verification.

# The central License Server this deployment activates against (see docs/license-setup.md).
LICENSE_SERVER_URL=http://localhost:4200
# Optional — trust a self-signed License Server dev/test certificate, same pattern as the
# agent's UEM_SERVER_CA_PATH. Unset when the License Server has a publicly-trusted cert.
LICENSE_SERVER_CA_PATH=
# How many days this deployment keeps operating on cached license state after the License
# Server becomes unreachable (network error only — an explicit REVOKED/EXPIRED response
# fails closed immediately regardless of this setting).
LICENSE_OFFLINE_GRACE_DAYS=14
# Kept OFF until the licensing flow has been manually verified end-to-end against a real
# License Server. Flip to true to actually start blocking unlicensed enrollment.
LICENSE_ENFORCEMENT_ENABLED=false
