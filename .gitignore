node_modules/
dist/
dist-installer/
*.db
*.db-journal
**/uploads/*
!**/uploads/.gitkeep
packages/server/agent-installer/*
!packages/server/agent-installer/.gitkeep
certs/
certs-trust/
.env
.env.local
*.log
.state/

# MS Office lock/temp files (created while a .docx/.rtf/.xlsx is open, not real content)
~$*

# Prisma generated client - license-server's custom output path (regenerated via
# `prisma generate`, see the two-Prisma-clients-collide-under-npm-workspace-hoisting note)
packages/license-server/generated/
packages/*/node_modules/.prisma/

# Deployment build artifacts - always rebuilt from source (npm run package[:update])
*.zip

# The server serves the console from here, but it is a build artifact copied from
# packages/console/dist - regenerated by the build, never hand-edited. (Plus any dated backups.)
packages/server/console-dist/
packages/server/console-dist.bak-*/

# native-dlp (C++/MSBuild toolchain output - regenerated by the VS build, never hand-edited)
native-dlp/bin/
native-dlp/**/x64/
native-dlp/**/Debug/
native-dlp/**/Release/
native-dlp/**/.vs/
*.obj
*.pdb
*.ilk
*.exp
*.lib
