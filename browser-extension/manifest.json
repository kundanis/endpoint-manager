{
  "manifest_version": 3,
  "name": "Endpoint IQ Mail Guard",
  "short_name": "Mail Guard",
  "version": "0.4.1",
  "description": "Stops emails from Gmail that contain protected personal data, as set by your organization’s Endpoint IQ policy.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.google.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "vendor/jszip.min.js",
        "scanner.js",
        "gmail.js"
      ],
      "run_at": "document_start"
    }
  ],
  "options_page": "options.html",
  "storage": {
    "managed_schema": "managed-schema.json"
  }
}
