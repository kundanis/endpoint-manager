{
  "manifest_version": 3,
  "name": "Endpoint IQ Browser Guard",
  "short_name": "Browser Guard",
  "version": "0.5.0",
  "description": "Stops personal and confidential data leaving through Gmail or AI websites such as ChatGPT, Gemini and Claude, as set by your organization’s Endpoint IQ policy.",
  "key": "",
